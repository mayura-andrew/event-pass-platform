# Copy this file to .env and chmod 600 .env.
# APP_DOMAIN must resolve to this EC2 instance before Caddy can issue a certificate.
APP_DOMAIN=pass.example.com

# Three database logins (docs/decisions/0010-database-roles.md):
#   MIGRATE_DATABASE_URL  the RDS master / table owner; used only by event-pass-migrate.
#   DATABASE_URL          the API: a login IN ROLE event_pass_api. The API refuses
#                         to start in production as the owner or a superuser.
#   WORKER_DATABASE_URL   the worker: a login IN ROLE event_pass_worker.
# After the first migration, as the owner:
#   CREATE ROLE event_pass_app  LOGIN PASSWORD '...' IN ROLE event_pass_api;
#   CREATE ROLE event_pass_jobs LOGIN PASSWORD '...' IN ROLE event_pass_worker;
MIGRATE_DATABASE_URL=postgres://OWNER:PASSWORD@RDS_ENDPOINT:5432/DATABASE?sslmode=require
DATABASE_URL=postgres://event_pass_app:PASSWORD@RDS_ENDPOINT:5432/DATABASE?sslmode=require
WORKER_DATABASE_URL=postgres://event_pass_jobs:PASSWORD@RDS_ENDPOINT:5432/DATABASE?sslmode=require

# Generate once with: openssl rand -hex 32
JWT_SECRET=
# Generate each once with: openssl rand -base64 32 (independent of JWT_SECRET;
# production refuses to start without them)
PASS_SIGNING_KEYS=1:
INTEGRATIONS_KEY=

APP_BASE_URL=https://pass.example.com
PRODUCT_NAME=Event Pass Platform
EVENT_NAME=Event Pass
PUBLIC_DIR=/app/public

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM='Event Pass Platform <no-reply@example.com>'

# Optional settings
PLATFORM_ADMIN_EMAILS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
STATUS_PAGE_URL=
# APP_ENV=production and CLIENT_IP_HEADER=X-Client-IP are set in docker-compose.yaml.
# Bearer token an uptime monitor sends for detailed /api/v1/health (openssl rand -hex 24).
HEALTH_TOKEN=
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=4h
# Birth dates are deleted this long after an event ends (0 keeps them).
BIRTH_DATE_RETENTION=720h
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450
DB_MAX_CONNS=10
