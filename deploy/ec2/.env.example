# Copy this file to .env and chmod 600 .env.
# APP_DOMAIN must resolve to this EC2 instance before Caddy can issue a certificate.
APP_DOMAIN=pass.example.com

# Use the RDS endpoint, database name, user, and password. sslmode=require
# is recommended for an RDS connection.
DATABASE_URL=postgres://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE?sslmode=require

# Generate once with: openssl rand -hex 32
JWT_SECRET=
# Generate once with: openssl rand -base64 32
PASS_SIGNING_KEYS=1:
INTEGRATIONS_KEY=

APP_BASE_URL=https://pass.example.com
PRODUCT_NAME=Event Pass Platform
EVENT_NAME=Event Pass
PUBLIC_DIR=/app/public

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Pass Platform <no-reply@example.com>

# Optional settings
PLATFORM_ADMIN_EMAILS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
STATUS_PAGE_URL=
CLIENT_IP_HEADER=
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450
DB_MAX_CONNS=10
