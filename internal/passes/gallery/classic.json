{
  "schema": 1,
  "size": { "preset": "phone", "width": 1080, "height": 1920 },
  "background": "token:surface",
  "elements": [
    { "id": "band", "type": "statusBand", "x": 0, "y": 0, "w": 1080, "h": 190, "font": { "size": 64, "weight": 700 } },
    { "id": "org", "type": "text", "text": "{{org.name}}", "transform": "upper", "x": 72, "y": 250, "w": 936, "h": 50,
      "font": { "size": 34, "weight": 700 }, "color": "token:muted", "align": "center", "shrinkToFit": { "min": 26 } },
    { "id": "event", "type": "text", "text": "{{event.name}}", "x": 72, "y": 306, "w": 936, "h": 140,
      "font": { "size": 56, "weight": 700 }, "color": "token:ink", "align": "center", "maxLines": 2, "shrinkToFit": { "min": 38 } },
    { "id": "name", "type": "text", "text": "{{participant.fullName}}", "x": 72, "y": 470, "w": 936, "h": 230,
      "font": { "size": 96, "weight": 700 }, "color": "token:ink", "align": "center", "maxLines": 2, "shrinkToFit": { "min": 52 } },
    { "id": "answers", "type": "answers", "x": 72, "y": 720, "w": 936, "h": 150,
      "font": { "size": 38, "weight": 400 }, "color": "token:muted", "align": "center", "shrinkToFit": { "min": 30 } },
    { "id": "qr", "type": "qr", "x": 220, "y": 900, "size": 640, "fg": "#15202B", "bg": "#FFFFFF", "quietZone": 4, "ecc": "M" },
    { "id": "passId", "type": "text", "text": "{{pass.id}}", "x": 72, "y": 1568, "w": 936, "h": 80,
      "font": { "size": 60, "weight": 700 }, "color": "token:ink", "align": "center", "shrinkToFit": { "min": 40 } },
    { "id": "rule", "type": "line", "x": 72, "y": 1665, "w": 936, "h": 2, "color": "token:line" },
    { "id": "when", "type": "text", "text": "{{event.when}}", "x": 72, "y": 1690, "w": 936, "h": 110,
      "font": { "size": 40, "weight": 400 }, "color": "token:muted", "align": "center", "maxLines": 2, "shrinkToFit": { "min": 30 } }
  ]
}
