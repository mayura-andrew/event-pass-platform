# PostgreSQL connection string
DATABASE_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=8080
PUBLIC_DIR=./public
APP_BASE_URL=http://localhost:8080
PRODUCT_NAME=Event Pass Platform
EVENT_NAME=Event Pass
SESSION_TTL=12h

# Comma-separated. Only these accounts can create organizations; everyone
# else signs in for their passes or joins an organization by invite.
# Empty: nobody can create an organization from the app.
PLATFORM_ADMIN_EMAILS=

# Docker Compose routes local email to Mailpit at http://localhost:8025.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Pass Platform <no-reply@event-pass.local>

# Google sign-in and integrations are optional.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PASS_SIGNING_KEYS=
INTEGRATIONS_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
STATUS_PAGE_URL=
ALLOWED_ORIGIN=
CLIENT_IP_HEADER=
LOGIN_RATE_PER_MIN=30
PASS_RATE_PER_MIN=120
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450
DB_MAX_CONNS=10
