# PostgreSQL connection string
DATABASE_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=8080
PUBLIC_DIR=./public
APP_BASE_URL=http://localhost:8080
PRODUCT_NAME=Event Pass Platform
EVENT_NAME=Event Pass
SESSION_TTL=12h

# SMTP is optional for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Pass Platform <no-reply@example.org>

# Google sign-in and integrations are optional.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PASS_SIGNING_KEYS=
INTEGRATIONS_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
STATUS_PAGE_URL=
ALLOWED_ORIGIN=
CLIENT_IP_HEADER=
LOGIN_RATE_PER_MIN=30
PASS_RATE_PER_MIN=120
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450
DB_MAX_CONNS=10
