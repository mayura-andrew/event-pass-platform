# PostgreSQL connection string
DATABASE_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# production: refuse to start with development fallbacks (derived keys,
# http links, no CLIENT_IP_HEADER, an owner or superuser database login).
APP_ENV=development

PORT=8080
PUBLIC_DIR=./public
APP_BASE_URL=http://localhost:8080
PRODUCT_NAME=Event Pass Platform
EVENT_NAME=Event Pass
SESSION_TTL=12h
# Sign out a session nobody has used for this long (0 = never).
SESSION_IDLE_TIMEOUT=4h

# Comma-separated. Only these accounts can create organizations; everyone
# else signs in for their passes or joins an organization by invite.
# Empty: nobody can create an organization from the app.
PLATFORM_ADMIN_EMAILS=

# Docker Compose routes local email to Mailpit at http://localhost:8025.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Event Pass Platform <no-reply@event-pass.local>

# Google sign-in and integrations are optional.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PASS_SIGNING_KEYS=
INTEGRATIONS_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
STATUS_PAGE_URL=
ALLOWED_ORIGIN=
# The header your proxy OVERWRITES with the client IP (not X-Forwarded-For).
CLIENT_IP_HEADER=
LOGIN_RATE_PER_MIN=30
PASS_RATE_PER_MIN=120
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450
DB_MAX_CONNS=10
# Bearer token for detailed /api/v1/health checks (empty: status word only).
HEALTH_TOKEN=
# Birth dates are deleted this long after an event ends (0 keeps them).
BIRTH_DATE_RETENTION=720h
# Run emails, Google sync and retention in this process (false when cmd/worker does).
RUN_WORKERS=true
